{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "DeepseekCombo",
  "small_model": "DeepseekCombo",
  "default_agent": "code",
  "provider": {
    "opencode-zen": {
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "timeout": 120000
      },
      "models": {
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash Free"
        },
        "ling-3-0-flash-free": {
          "name": "Ling 3.0 Flash Free"
        }
      },
      "whitelist": [
        "deepseek-*",
        "deepseek-v4-*",
        "ling-*"
      ],
      "requires_key": false
    },
    "deepseek": {
      "options": {
        "baseURL": "https://api.deepseek.com",
        "timeout": 120000
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        }
      }
    },
    "openai": {
      "options": {
        "baseURL": "https://api.openai.com/v1",
        "timeout": 120000
      },
      "models": {
        "gpt-4o-mini": {
          "name": "OpenAI GPT-4o Mini"
        }
      }
    },
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 120000
      },
      "models": {
        "gemma4:12b": {
          "name": "Gemma 4 12B (Ollama)"
        },
        "gemma4": {
          "name": "Gemma 4 (Ollama)"
        },
        "qwen2.5": {
          "name": "Qwen 2.5 (Ollama)"
        },
        "qwen2.5:3b": {
          "name": "Qwen 2.5 3B (Ollama)"
        },
        "llama3.2": {
          "name": "Llama 3.2 (Ollama)"
        }
      },
      "requires_key": false
    },
    "9router": {
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "timeout": 120000
      },
      "models": {
        "DeepseekCombo": {
          "name": "DeepseekCombo (9Router)"
        },
        "KiloCombo": {
          "name": "KiloCombo (9Router)"
        }
      },
      "requires_key": false
    }
  },
  "enabled_providers": [
    "ollama",
    "opencode-zen",
    "deepseek",
    "openai",
    "9router"
  ],
  "disabled_providers": [],
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      "./delta/skills"
    ],
    "urls": []
  },
  "commands": {
    "paths": [
      "./delta/skills"
    ],
    "urls": []
  },
  "agents": {
    "code": {
      "description": "Primary coding agent for Delta CLI",
      "mode": "primary",
      "model": "DeepseekCombo",
      "steps": 25,
      "hidden": false,
      "color": "#FF5733",
      "permission": {
        "bash": "allow",
        "edit": {
          "delta/**": "allow",
          "tests/**": "allow",
          "*": "ask"
        },
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  },
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "share": "manual"
}