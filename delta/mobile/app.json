{
  "expo": {
    "name": "Delta Agent",
    "slug": "delta-agent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LogoDelta.png",
    "scheme": "delta",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/LogoDelta.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deltasec.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Delta requires camera access for live security assessment, visual inspection, and live stream monitoring.",
        "NSMicrophoneUsageDescription": "Delta requires microphone access for voice command and security assessment.",
        "NSPhotoLibraryUsageDescription": "Delta requires photo library access to attach audit screenshots.",
        "UIBackgroundModes": ["fetch", "remote-notification"],
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "com.deltasec.mobile",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/LogoDelta.png",
        "backgroundColor": "#0a0e17"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
